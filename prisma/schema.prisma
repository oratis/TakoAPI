generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  apiKey        String?        @unique
  provider      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          String         @default("user")
  bio           String?
  username      String?        @unique
  website       String?
  accounts      Account[]
  agents        Agent[]
  apiKeys       ApiKey[]
  adminLogs     AdminLog[]
  AuthorFollow  AuthorFollow[]
  BlogPost      BlogPost[]
  Bookmark      Bookmark[]
  likes         Like[]
  sessions      Session[]
  skills        Skill[]
  creditBalance CreditBalance?
  ledgerEntries LedgerEntry[]
  agentRatings   AgentRating[]
  agentBookmarks AgentBookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  skillCount  Int     @default(0)
  skills      Skill[]
  agents      Agent[]
}

enum SkillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentType {
  CLAUDE_CODE
  CURSOR
  WINDSURF
  ZED
  CODEX
  COPILOT
  AIDER
  CLINE
  GENERIC
}

enum SkillSource {
  USER_SUBMITTED
  GITHUB_SCRAPE
  CURATED
}

model Skill {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String
  githubUrl     String?
  clawHubUrl    String?
  installCmd    String?
  author        String?
  categoryId    String
  submitterId   String?
  featured      Boolean     @default(false)
  likesCount    Int         @default(0)
  viewsCount    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  brief         String?
  clawSkillsUrl String?
  downloads     Int         @default(0)
  readme        String?
  stars         Int         @default(0)
  status        SkillStatus @default(PENDING)
  reviewNote    String?
  avgRating     Float       @default(0)
  ghCheckedAt   DateTime?
  ghStatus      String?
  ratingCount   Int         @default(0)
  agentType     AgentType   @default(CLAUDE_CODE)
  source        SkillSource @default(USER_SUBMITTED)
  sourceUrl     String?
  ghStars       Int?
  ghOwner       String?
  ghRepo        String?
  Bookmark      Bookmark[]
  likes         Like[]
  category      Category    @relation(fields: [categoryId], references: [id])
  submitter     User?       @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  tags          SkillTag[]

  @@index([categoryId])
  @@index([slug])
  @@index([name])
  @@index([downloads])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([featured, likesCount(sort: Desc)])
  @@index([likesCount(sort: Desc)])
  @@index([status, downloads(sort: Desc)])
  @@index([viewsCount(sort: Desc)])
  @@index([status, categoryId])
  @@index([featured])
  @@index([updatedAt(sort: Desc)])
  @@index([agentType, status])
  @@index([source])
  @@index([ghOwner, ghRepo])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  skills    SkillTag[]
  agentTags AgentTag[]
  createdAt DateTime   @default(now())
}

model SkillTag {
  skillId String
  tagId   String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skillId, tagId])
  @@index([tagId])
}

model RequestLog {
  id         String   @id @default(cuid())
  path       String
  method     String
  status     Int
  durationMs Int
  userId     String?
  ip         String?
  userAgent  String?
  errorCode  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([status, createdAt])
}

model Like {
  id      String @id @default(cuid())
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId])
}

model AdCampaign {
  id          String    @id
  name        String
  platform    String
  status      String    @default("draft")
  budget      Float     @default(0)
  spent       Float     @default(0)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Int       @default(0)
  cpc         Float?
  ctr         Float?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([platform])
  @@index([status])
}

model AuthorFollow {
  id        String   @id
  userId    String
  author    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, author])
  @@index([author])
}

model BlogPost {
  id          String    @id
  slug        String    @unique
  title       String
  description String
  content     String
  coverImage  String?
  tags        String?
  authorId    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User?     @relation(fields: [authorId], references: [id])

  @@index([published])
  @@index([slug])
}

model Bookmark {
  id        String   @id
  userId    String
  skillId   String
  createdAt DateTime @default(now())
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model KolContact {
  id          String        @id
  name        String
  author      String?
  email       String?
  twitter     String?
  linkedin    String?
  website     String?
  tier        String        @default("3")
  skills      Int           @default(0)
  downloads   Int           @default(0)
  stars       Int           @default(0)
  notes       String?
  status      String        @default("pending")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  avgComments Int           @default(0)
  avgLikes    Int           @default(0)
  avgViews    Int           @default(0)
  lastPostAt  DateTime?
  platform    String        @default("github")
  subscribers Int           @default(0)
  youtube     String?
  KolOutreach KolOutreach[]

  @@index([platform])
  @@index([status])
  @@index([tier])
}

model KolOutreach {
  id         String     @id
  kolId      String
  channel    String
  subject    String?
  content    String?
  sentAt     DateTime   @default(now())
  replied    Boolean    @default(false)
  repliedAt  DateTime?
  replyNote  String?
  KolContact KolContact @relation(fields: [kolId], references: [id], onDelete: Cascade)

  @@index([kolId])
}

model Rating {
  id        String   @id
  userId    String
  skillId   String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([userId, skillId])
  @@index([skillId])
}

model SkillEvent {
  id        String   @id
  skillId   String
  type      String
  referrer  String?
  country   String?
  createdAt DateTime @default(now())

  @@index([skillId, createdAt])
  @@index([skillId, type])
}

model Subscriber {
  id        String   @id
  email     String   @unique
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Agent registry — Phase 1 of "One API to access all agents".
// Invokable third-party agents, described by A2A AgentCards.
// NOTE: distinct from Skill.agentType, which classifies the coding
// agents that *consume* skills. Keys/usage/credits models arrive in
// Phase 2–3. See docs/agent-marketplace/04-data-model.md
// ─────────────────────────────────────────────────────────────

enum AgentProtocol {
  A2A
  OPENAI_COMPAT
  MCP
}

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum PricingModel {
  FREE
  PER_CALL
  PER_TASK
  PER_TOKEN
}

enum AgentKind {
  HOSTED // invokable agent with a live A2A endpoint
  PROJECT // open-source project (self-host); discovery-only
}

model Agent {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  publisherId String
  categoryId  String?
  status      AgentStatus @default(PENDING)
  reviewNote  String?
  kind        AgentKind   @default(HOSTED)

  // Scenario / use-case classification (job-to-be-done), e.g. "frontend",
  // "investing", "presentations". Multi-valued; filtered with `has`. The
  // taxonomy + classifier live in src/lib/scenarios.ts. Distinct from
  // categoryId (the skill technical taxonomy).
  scenarios String[] @default([])

  // AgentCard (A2A) — discovery + invocation metadata (HOSTED only)
  cardUrl               String?
  endpointUrl           String?
  protocols             AgentProtocol[] @default([])
  streaming             Boolean         @default(false)
  pushNotify            Boolean         @default(false)
  securitySchemes       Json?
  cardSignatureVerified Boolean         @default(false)
  namespaceVerified     Boolean         @default(false)
  cardFetchedAt         DateTime?
  healthStatus          String?
  healthCheckedAt       DateTime?

  // Pricing — display metadata only; real billing lands in Phase 3
  pricingModel  PricingModel @default(FREE)
  unitPriceUsd  Decimal?     @db.Decimal(12, 6)
  byokSupported Boolean      @default(false)

  // Open-source project (kind = PROJECT)
  githubUrl String?
  stars     Int?
  repoOwner String?
  repoName  String?

  // Presentation + stats
  homepage   String?
  logo       String?
  featured   Boolean  @default(false)
  likesCount  Int     @default(0)
  callsCount  Int     @default(0)
  avgRating   Float   @default(0)
  ratingCount Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  publisher   User            @relation(fields: [publisherId], references: [id])
  category    Category?       @relation(fields: [categoryId], references: [id])
  skills      AgentSkillDef[]
  tags        AgentTag[]
  invocations Invocation[]
  ratings     AgentRating[]
  bookmarks   AgentBookmark[]

  @@index([status, categoryId])
  @@index([featured, callsCount(sort: Desc)])
  @@index([publisherId])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@index([status, kind])
  @@index([kind, stars(sort: Desc)])
}

model AgentSkillDef {
  id          String   @id @default(cuid())
  agentId     String
  skillKey    String
  name        String
  description String?
  inputModes  String[] @default([])
  outputModes String[] @default([])
  examples    String[] @default([])
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model AgentTag {
  agentId String
  tagId   String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([agentId, tagId])
  @@index([tagId])
}

// Per-user agent rating (1–5) + optional review. Additive and decoupled from
// the Skill-scoped Rating model. avgRating/ratingCount on Agent are kept in
// sync on each write. See src/app/api/agents/[slug]/rating/route.ts.
model AgentRating {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
}

// Per-user agent bookmark (toggle). Additive; decoupled from Skill Bookmark.
model AgentBookmark {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
  @@index([agentId])
}

// ─────────────────────────────────────────────────────────────
// Gateway (Phase 2) — API keys + per-call usage metering.
// Billing/credits arrive in Phase 3. See docs/agent-marketplace/04-data-model.md
// ─────────────────────────────────────────────────────────────

model ApiKey {
  id           String       @id @default(cuid())
  userId       String
  name         String?
  hashedKey    String       @unique
  prefix       String
  scopes       String[]     @default([])
  rateLimit    Int?
  monthlyQuota Int?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invocations  Invocation[]

  @@index([userId])
  @@index([prefix])
}

model Invocation {
  id          String        @id @default(cuid())
  apiKeyId    String?
  userId      String?
  agentId     String
  protocol    AgentProtocol
  status      Int
  taskState   String?
  latencyMs   Int?
  unitsBilled Decimal?      @db.Decimal(14, 6)
  costUsd     Decimal?      @db.Decimal(14, 6)
  billedUsd   Decimal?      @db.Decimal(14, 6)
  errorCode   String?
  createdAt   DateTime      @default(now())
  agent       Agent         @relation(fields: [agentId], references: [id])
  apiKey      ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Commercial / ledger (Phase 3) — prepaid credits + immutable ledger.
// PayPal top-up lands later; the gateway debits on each billed invocation.
// See docs/agent-marketplace/04-data-model.md §2.
// ─────────────────────────────────────────────────────────────

enum LedgerType {
  TOPUP // credit purchase (PayPal)
  TOPUP_FEE // platform fee on a top-up
  DEBIT // agent call charge
  PAYOUT // settlement to a publisher
  REFUND // credit returned
  ADJUST // manual / admin correction
}

model CreditBalance {
  userId     String   @id
  balanceUsd Decimal  @default(0) @db.Decimal(14, 6)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  type         LedgerType
  amountUsd    Decimal    @db.Decimal(14, 6) // +credit / -debit
  invocationId String? // set for DEBIT entries
  providerRef  String? // PayPal order/capture id, set for TOPUP / REFUND
  note         String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([invocationId])
}

// ─────────────────────────────────────────────────────────────
// Shared rate-limit store. Backs src/lib/ratelimit.ts so a fixed
// window holds across all Cloud Run instances (an in-memory Map
// gave each replica its own counter → effective limit × replicas).
// One row per "namespace:clientIp" bucket; advanced + incremented
// atomically via INSERT … ON CONFLICT. resetAt is an absolute
// instant (timestamptz) so the window is timezone-independent.
// ─────────────────────────────────────────────────────────────

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}
